{
  "name": "sunrisegases",
  "compatibility_date": "2026-07-01",
  "routes": [
    {
      "pattern": "sunrisegases.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.sunrisegases.com",
      "custom_domain": true,
    },
  ],
  "fail_open": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
