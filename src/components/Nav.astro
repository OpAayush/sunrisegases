---
const links = [
  { href: '/gases/', label: 'Gases' },
  { href: '/equipment/', label: 'Equipment' },
  { href: '/fire-safety/', label: 'Fire Safety' },
  { href: '/balloons/', label: 'Balloons' },
  { href: '/industries/', label: 'Industries' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="/images/icons/flame.svg" alt="" class="nav-logo-icon" />
      <span class="nav-logo-text">Sunrise Gases</span>
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href} class="nav-link">{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
  }
  .nav-inner {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-logo-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .nav-logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 1.5rem;
  }
  .nav-link {
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: 0.25rem 0;
  }
  .nav-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 0.75rem;
    }
    .nav-logo-text {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .nav-links {
      gap: 0.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.25rem;
    }
    .nav-link {
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .nav-inner {
      padding: 0 1rem;
    }
  }
</style>
