---
const links = [
  { href: '/gases/', label: 'Gases', icon: '/images/icons/gas-cylinder.svg' },
  { href: '/equipment/', label: 'Equipment', icon: '/images/icons/truck.svg' },
  { href: '/fire-safety/', label: 'Fire Safety', icon: '/images/icons/fire-extinguisher.svg' },
  { href: '/balloons/', label: 'Balloons', icon: '/images/icons/package.svg' },
  { href: '/industries/', label: 'Industries' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact', icon: '/images/icons/phone.svg' },
];
const currentPath = Astro.url.pathname;
---

<nav class="nav" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="/images/icons/flame.svg" alt="" class="nav-logo-icon" />
      <span class="nav-logo-text">Sunrise Gases</span>
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href} class="nav-link" aria-current={currentPath.startsWith(link.href) && link.href !== '/' ? 'page' : undefined}>{link.icon && <img src={link.icon} alt="" class="nav-link-icon" />}{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
  }
  .nav-inner {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-logo-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .nav-logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 1.5rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: 0.25rem 0;
  }
  .nav-link-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .nav-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 0.75rem;
    }
    .nav-logo-text {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .nav-links {
      gap: 0.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.25rem;
      mask-image: linear-gradient(to right, transparent, black 0.5rem, black 90%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 0.5rem, black 90%, transparent);
    }
    .nav-link {
      font-size: 0.8125rem;
      white-space: nowrap;
      padding: 0.5rem 0.5rem;
      min-height: 36px;
    }
    .nav-inner {
      padding: 0 1rem;
    }
    .nav-link-icon {
      display: none;
    }
  }
</style>
