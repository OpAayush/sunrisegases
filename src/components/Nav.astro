---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
const nav = await getEntry('site', 'nav');
const links = nav?.data.kind === 'nav' ? nav.data.links : [];
const currentPath = Astro.url.pathname;
const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/icon-*.svg', { eager: true });
const iconSrc = (name?: string) => (name ? icons[`/src/assets/products/${name}.svg`]?.default.src : undefined);
const logo = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/logo-sunrise-gases.webp', { eager: true });
const logoSrc = logo['/src/assets/products/logo-sunrise-gases.webp'].default.src;
---

<nav class="nav" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src={logoSrc} alt="Sunrise Gases" class="nav-logo-img" />
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href} class="nav-link" aria-current={currentPath.startsWith(link.href) && link.href !== '/' ? 'page' : undefined}>{link.icon && <img src={iconSrc(link.icon)} alt="" class="nav-link-icon" />}{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
  }
  .nav-inner {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-logo-img {
    height: 28px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 1.5rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: 0.25rem 0;
  }
  .nav-link-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .nav-link:hover {
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .nav-link[aria-current="page"] {
    color: var(--color-accent-text);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 0.75rem;
    }
  }
  @media (max-width: 600px) {
    .nav-links {
      gap: 0.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.25rem;
      mask-image: linear-gradient(to right, transparent, black 0.5rem, black 90%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 0.5rem, black 90%, transparent);
    }
    .nav-link {
      font-size: 0.8125rem;
      white-space: nowrap;
      padding: 0.5rem 0.5rem;
      min-height: 44px;
    }
    .nav-inner {
      padding: 0 1rem;
    }
    .nav-link-icon {
      display: none;
    }
  }
</style>
