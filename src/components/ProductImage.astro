---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className, widths, sizes, loading = 'lazy' } = Astro.props;
---

{src.format === 'svg' ? (
  <img src={src.src} alt={alt} class={className} loading={loading} />
) : (
  <Image src={src} alt={alt} class={className} widths={widths} sizes={sizes} loading={loading} />
)}
