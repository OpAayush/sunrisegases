---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
const footer = await getEntry('site', 'footer');
const footerData = footer?.data.kind === 'footer' ? footer.data : { description: '', location: '', established: '' };
const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/icon-*.svg', { eager: true });
const mapPin = icons['/src/assets/products/icon-map-pin.svg'].default.src;
const logo = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/logo-sunrise-gases.webp', { eager: true });
const logoSrc = logo['/src/assets/products/logo-sunrise-gases.webp'].default.src;
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-col">
      <img src={logoSrc} alt="Sunrise Gases — industrial and specialty gas manufacturer in Nagpur" class="footer-logo" />
      <p class="footer-text">{footerData.description}</p>
    </div>
    <div class="footer-col">
      <h3 class="footer-heading">Products</h3>
      <ul class="footer-list">
        <li><a href="/gases/">Industrial gases</a></li>
        <li><a href="/gas-mixtures/">Gas mixtures</a></li>
        <li><a href="/refrigerants/">Refrigerants</a></li>
        <li><a href="/cryogenic/">Cryogenic</a></li>
        <li><a href="/specialty-gases/">Specialty gases</a></li>
        <li><a href="/equipment/">Gas equipment</a></li>
        <li><a href="/fire-safety/">Fire safety</a></li>
        <li><a href="/balloons/">Advertising balloons</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h3 class="footer-heading">Company</h3>
      <ul class="footer-list">
        <li><a href="/about/">About us</a></li>
        <li><a href="/industries/">Industries served</a></li>
        <li><a href="/quality-and-safety/">Quality & safety</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h3 class="footer-heading">Office</h3>
      <address class="footer-address">
        <img src={mapPin} alt="" class="footer-icon" />
        Meghraj Chawl, 212A, Gandhi Chowk<br />
        Sadar, Nagpur 440001<br />
        <a href="https://maps.app.goo.gl/pmto13xLtkvdeTrn9" target="_blank" rel="noopener">Map →</a>
      </address>
    </div>
    <div class="footer-col">
      <h3 class="footer-heading">Works</h3>
      <address class="footer-address">
        <img src={mapPin} alt="" class="footer-icon" />
        Sharma Engineering Works<br />
        W52, MIDC, Hingna Road<br />
        Nagpur 440016<br />
        <a href="https://www.google.com/maps?q=21.1154769,79.0007651" target="_blank" rel="noopener">Map →</a>
      </address>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>Manufacturing and supplying industrial gases since {footerData.established}.</span>
      <span class="footer-sep">·</span>
      <span>{footerData.location}</span>
      <span class="footer-sep">·</span>
      <span>Made by <a href="https://spicydevs.js.org" target="_blank" rel="noopener" class="footer-credit">SpicyDevs</a></span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    margin-top: var(--space-section);
  }
  .footer-inner {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .footer-logo {
    height: 36px;
    width: auto;
    margin-bottom: 0.75rem;
  }
  .footer-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }
  .footer-text {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .footer-list a {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-body);
    transition: color var(--transition-fast);
  }
  .footer-list a:hover {
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .footer-icon {
    width: 14px;
    height: 14px;
    vertical-align: middle;
    margin-right: 0.25rem;
    flex-shrink: 0;
  }
  .footer-address {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    font-style: normal;
    line-height: 1.5;
  }
  .footer-address a {
    color: var(--color-accent-text);
    font-weight: 500;
  }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
  }
  .footer-bottom-inner {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-body);
    color: var(--color-text-secondary);
  }
  .footer-sep {
    color: var(--color-border);
  }
  .footer-credit {
    color: var(--color-accent-text);
    font-weight: 500;
  }
  .footer-credit:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-sep {
      display: none;
    }
  }
</style>
