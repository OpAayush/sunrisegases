---
interface Props { src: string; title: string; height?: number }
const { src, title, height = 220 } = Astro.props;
---
<div class="map-embed" style={`height:${height}px`} data-src={src} data-title={title}>
  <button type="button" class="map-embed-btn">Show map</button>
</div>
<style is:global>
  .map-embed { display: flex; align-items: center; justify-content: center; background: var(--color-parchment-shadow); border-radius: 12px; }
  .map-embed-btn { min-height: 44px; padding: 0.6rem 1.25rem; border-radius: var(--radius-buttons); background: var(--color-text); color: #fff; font-weight: 600; cursor: pointer; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.map-embed').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = el.dataset.src ?? '';
      f.title = el.dataset.title ?? 'Map';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.allowFullscreen = true;
      f.style.cssText = 'border:0;width:100%;height:100%;border-radius:12px';
      el.replaceChildren(f);
    });
  });
</script>
