---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('gas-mixtures');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <article class="detail">
    <header class="detail-hero">
      <span class="detail-label">Gas Mixture</span>
      <h1 class="detail-name">{data.name}</h1>
      <p class="detail-blend">{data.blendRationale}</p>
    </header>

    <section class="detail-section">
      <h2 class="section-title">Composition</h2>
      <div class="comp-list">
        {data.components.map((comp) => (
          <div class="comp-row">
            <span class="comp-gas">{comp.gas}</span>
            <span class="comp-ratio">{comp.ratio}</span>
          </div>
        ))}
      </div>
    </section>

    {data.applications && data.applications.length > 0 && (
      <section class="detail-section">
        <h2 class="section-title">Applications</h2>
        <ul class="app-list">
          {data.applications.map((app) => <li>{app}</li>)}
        </ul>
      </section>
    )}

    <section class="detail-section detail-section--last">
      <h2 class="section-title">Packaging</h2>
      {data.packaging.map((pkg) => (
        <div class="pkg-item">
          <span class="pkg-type">{pkg.type}</span>
          <span class="pkg-sizes">{pkg.sizes.join(', ')}</span>
        </div>
      ))}
      {data.safety?.hazardClass && <div class="safety-badge">{data.safety.hazardClass}</div>}
    </section>
  </article>
</BaseLayout>

<style>
  .detail { max-width: var(--space-container); margin: 0 auto; padding: var(--space-section) 1.5rem; }
  .detail-hero { margin-bottom: 2rem; }
  .detail-label { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent); display: block; margin-bottom: 0.5rem; }
  .detail-name { font-family: var(--font-serif); font-weight: 600; font-size: var(--text-hero); line-height: 1.2; color: var(--color-text); margin-bottom: 0.75rem; }
  .detail-blend { font-size: var(--text-body); color: var(--color-text-secondary); line-height: 1.6; max-width: 640px; }
  .detail-section { padding: 2rem 0; border-top: 1px solid var(--color-border); }
  .detail-section--last { border-bottom: 1px solid var(--color-border); }
  .section-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h2); color: var(--color-text); margin-bottom: 1.25rem; }
  .comp-list { background: var(--color-card); border-radius: var(--radius-cards); overflow: hidden; box-shadow: var(--shadow-sm); }
  .comp-row { display: flex; justify-content: space-between; padding: 0.875rem 1.5rem; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); }
  .comp-row:last-child { border-bottom: none; }
  .comp-gas { font-weight: 500; color: var(--color-text); }
  .comp-ratio { color: var(--color-text-secondary); font-family: var(--font-mono); }
  .app-list { list-style: none; display: flex; flex-direction: column; gap: 0.375rem; }
  .app-list li { font-size: var(--text-body); color: var(--color-text-secondary); padding-left: 1.25rem; position: relative; }
  .app-list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }
  .pkg-item { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); }
  .pkg-item:last-of-type { border-bottom: none; }
  .pkg-type { font-weight: 500; color: var(--color-text); }
  .pkg-sizes { color: var(--color-text-secondary); }
  .safety-badge { display: inline-block; margin-top: 1rem; padding: 0.25rem 0.75rem; font-size: var(--text-small); font-weight: 600; color: var(--color-card); background: var(--color-accent); border-radius: var(--radius-tags); }
</style>
