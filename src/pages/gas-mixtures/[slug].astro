---
import ProductDetailLayout from '../../layouts/ProductDetailLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('gas-mixtures');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Gas Mixtures", "item": "https://sunrisegases.com/gas-mixtures/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/gas-mixtures/${data.slug}/` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": data.name,
  "name": `${data.name} Supply — Sunrise Gases`,
  "description": data.seo.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Sunrise Gases",
    "@id": "https://sunrisegases.com/#business",
  },
  "areaServed": [
    { "@type": "City", "name": "Nagpur" },
    { "@type": "City", "name": "Kamptee" },
    { "@type": "City", "name": "Hingna" },
    { "@type": "City", "name": "Kalmeshwar" },
  ],
  "image": data.images?.[0] ? `https://sunrisegases.com${data.images[0].src.src}` : undefined,
};
---

<ProductDetailLayout
  title={data.seo.title}
  description={data.seo.description}
  schemas={[breadcrumbSchema, serviceSchema]}
  hero={{ name: data.name, label: 'Gas Mixture', blend: data.blendRationale, size: 'md' }}
  images={data.images}
>
  <section class="detail-section">
    <h2 class="section-title">Composition</h2>
    <div class="comp-list">
      {data.components.map((comp) => (
        <div class="comp-row">
          <span class="comp-gas">{comp.gas}</span>
          <span class="comp-ratio">{comp.ratio}</span>
        </div>
      ))}
    </div>
  </section>

  {data.applications && data.applications.length > 0 && (
    <section class="detail-section">
      <h2 class="section-title">Applications</h2>
      <ul class="app-list">
        {data.applications.map((app) => <li>{app}</li>)}
      </ul>
    </section>
  )}

  <section class="detail-section detail-section--last">
    <h2 class="section-title">Packaging</h2>
    {data.packaging.map((pkg) => (
      <div class="pkg-item">
        <span class="pkg-type">{pkg.type}</span>
        <span class="pkg-sizes">{pkg.sizes.join(', ')}</span>
      </div>
    ))}
    {data.safety?.hazardClass && <div class="safety-badge">{data.safety.hazardClass}</div>}
  </section>
</ProductDetailLayout>

<style>
  .comp-list { background: var(--color-card); border-radius: var(--radius-cards); overflow: hidden; box-shadow: var(--shadow-sm); }
  .comp-row { display: flex; justify-content: space-between; padding: 0.875rem 1.5rem; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); }
  .comp-row:last-child { border-bottom: none; }
  .comp-gas { font-weight: 500; color: var(--color-text); }
  .comp-ratio { color: var(--color-text-secondary); font-family: var(--font-mono); }
  .app-list { list-style: none; display: flex; flex-direction: column; gap: 0.375rem; }
  .app-list li { font-size: var(--text-body); color: var(--color-text-secondary); padding-left: 1.25rem; position: relative; }
  .app-list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }
  .pkg-item { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); }
  .pkg-item:last-of-type { border-bottom: none; }
  .pkg-type { font-weight: 500; color: var(--color-text); }
  .pkg-sizes { color: var(--color-text-secondary); }
  .safety-badge { display: inline-block; margin-top: 1rem; padding: 0.25rem 0.75rem; font-size: var(--text-small); font-weight: 600; color: var(--color-card); background: var(--color-accent-deep); border-radius: var(--radius-tags); }
</style>
