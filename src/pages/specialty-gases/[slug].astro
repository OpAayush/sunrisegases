---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('specialty-gases');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Specialty Gases", "item": "https://sunrisegases.com/specialty-gases/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/specialty-gases/${data.slug}/` }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": data.name,
  "description": data.summary,
  "brand": { "@type": "Brand", "name": "Sunrise Gases" },
  "image": data.images?.[0] ? `https://sunrisegases.com${data.images[0].src}` : undefined,
};
---

<BaseLayout title={data.seo.title} description={data.seo.description} schemas={[breadcrumbSchema, productSchema]}>
  <article class="detail">
    <header class="detail-hero">
      <span class="detail-label">Specialty Gas</span>
      <h1 class="detail-name">{data.name}</h1>
    </header>

    {data.images && data.images.length > 0 && (
      <div class="product-images">
        {data.images.map((img) => (
          <img src={img.src} alt={img.alt} class="product-image" width="400" height="400" loading="lazy" />
        ))}
      </div>
    )}

    <section class="detail-section">
      <h2 class="section-title">Specifications</h2>
      <div class="spec-list">
        <div class="spec-row">
          <span class="spec-label">Purity</span>
          <span class="spec-value">{data.purity}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Certification</span>
          <span class="spec-value">{data.certification}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Traceability</span>
          <span class="spec-value">{data.traceability}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Tier</span>
          <span class="spec-value">{data.tier.replace(/-/g, ' ')}</span>
        </div>
      </div>
    </section>

    {data.applications && data.applications.length > 0 && (
      <section class="detail-section detail-section--last">
        <h2 class="section-title">Applications</h2>
        <ul class="app-list">
          {data.applications.map((app) => <li>{app}</li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .detail { max-width: var(--space-container); margin: 0 auto; padding: var(--space-section) 1.5rem; }
  .detail-hero { margin-bottom: 2rem; }
  .detail-label { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent); display: block; margin-bottom: 0.5rem; }
  .detail-name { font-family: var(--font-serif); font-weight: 600; font-size: var(--text-hero); line-height: 1.2; color: var(--color-text); }
  .detail-section { padding: 2rem 0; border-top: 1px solid var(--color-border); }
  .detail-section--last { border-bottom: 1px solid var(--color-border); }
  .section-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h2); color: var(--color-text); margin-bottom: 1.25rem; }
  .spec-list { background: var(--color-card); border-radius: var(--radius-cards); overflow: hidden; box-shadow: var(--shadow-sm); }
  .spec-row { display: flex; justify-content: space-between; padding: 0.875rem 1.5rem; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); gap: 1rem; }
  .spec-row:last-child { border-bottom: none; }
  .spec-label { font-weight: 500; color: var(--color-text); flex-shrink: 0; }
  .spec-value { color: var(--color-text-secondary); text-align: right; }
  .app-list { list-style: none; display: flex; flex-direction: column; gap: 0.375rem; }
  .app-list li { font-size: var(--text-body); color: var(--color-text-secondary); padding-left: 1.25rem; position: relative; }
  .app-list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }
</style>
