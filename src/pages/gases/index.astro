---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const gases = await getCollection('gases');
---

<BaseLayout title="Industrial Gases & Cylinders | Sunrise Gases" description="Complete range of industrial and specialty gases manufactured in Nagpur: oxygen, nitrogen, argon, carbon dioxide, hydrogen, helium, acetylene, LPG, ammonia.">
  <header class="catalog-hero">
    <h1 class="catalog-title">Industrial gases</h1>
    <p class="catalog-subtitle">Manufactured and supplied across Central India from our Nagpur facility.</p>
  </header>

  <section class="catalog-grid">
    {gases.sort((a, b) => a.data.name.localeCompare(b.data.name)).map((gas) => {
      const purity = gas.data.grades?.[0]?.purity;
      return (
        <a href={`/gases/${gas.data.slug}/`} class="product-card">
          {gas.data.images?.[0] && (
            <Image src={gas.data.images[0].src} alt={gas.data.images[0].alt} class="product-card-img" loading="lazy" />
          )}
          <span class="product-formula">{gas.data.formula || gas.data.slug.toUpperCase()}</span>
          <h2 class="product-name">{gas.data.name}</h2>
          {purity && <span class="product-purity">{purity}</span>}
          <span class="product-summary">{gas.data.summary}</span>
        </a>
      );
    })}
  </section>
</BaseLayout>

<style>
  .catalog-hero {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
  }
  .catalog-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .catalog-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 540px;
  }

  .catalog-grid {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 2rem 1.5rem var(--space-section);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .product-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .product-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .product-formula {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    color: var(--color-accent-text);
    line-height: 1.2;
  }
  .product-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-text);
  }
  .product-purity {
    font-size: 0.75rem;
    color: var(--color-accent-text);
    font-weight: 500;
  }
  .product-summary {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-top: 0.375rem;
  }

  @media (max-width: 768px) {
    .catalog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
