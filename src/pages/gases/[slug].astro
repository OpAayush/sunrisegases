---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const gases = await getCollection('gases');
  return gases.map((gas) => ({
    params: { slug: gas.data.slug },
    props: { gas },
  }));
}

const { gas } = Astro.props;
const { data } = gas;
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <article class="detail">
    <header class="detail-hero">
      <span class="detail-formula">{data.formula}</span>
      <h1 class="detail-name">{data.name}</h1>
      <p class="detail-summary">{data.summary}</p>
    </header>

    {data.images && data.images.length > 0 && (
      <div class="product-images">
        {data.images.map((img) => (
          <img src={img.src} alt={img.alt} class="product-image" />
        ))}
      </div>
    )}

    {data.grades && data.grades.length > 0 && (
      <section class="detail-section">
        <h2 class="section-title">Grades</h2>
        <div class="grades-grid">
          {data.grades.map((grade) => (
            <div class="grade-card">
              <div class="grade-header">
                <span class="grade-name">{grade.name}</span>
                <span class="grade-purity">{grade.purity}</span>
              </div>
              <ul class="grade-uses">
                {grade.uses.map((use) => <li>{use}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="detail-section">
      <h2 class="section-title">Supply &amp; Packaging</h2>
      <div class="supply-grid">
        <div class="supply-card">
          <h3 class="supply-label">Supply forms</h3>
          <ul class="supply-list">
            {data.supplyForms.map((form) => <li>{form}</li>)}
          </ul>
        </div>
        <div class="supply-card">
          <h3 class="supply-label">Packaging</h3>
          {data.packaging.map((pkg) => (
            <div class="pkg-item">
              <span class="pkg-type">{pkg.type}</span>
              <span class="pkg-sizes">{pkg.sizes.join(', ')}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {data.applications && data.applications.length > 0 && (
      <section class="detail-section">
        <h2 class="section-title">Applications</h2>
        <ul class="app-list">
          {data.applications.map((app) => <li>{app}</li>)}
        </ul>
      </section>
    )}

    <section class="detail-section detail-section--last">
      <h2 class="section-title">Safety &amp; Handling</h2>
      <div class="safety-badge">{data.safety.hazardClass}</div>
      <a href={data.safety.sdsUrl} class="safety-link">Download SDS (Safety Data Sheet) &rarr;</a>
    </section>
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .detail-hero {
    margin-bottom: 3rem;
  }
  .detail-formula {
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-accent);
    display: block;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .detail-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .detail-summary {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 640px;
  }

  .detail-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .detail-section--last {
    border-bottom: 1px solid var(--color-border);
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .grades-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .grade-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .grade-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
    gap: 0.5rem;
  }
  .grade-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-text);
  }
  .grade-purity {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-accent);
    font-weight: 500;
    white-space: nowrap;
  }
  .grade-uses {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .grade-uses li {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding-left: 1rem;
    position: relative;
  }
  .grade-uses li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .supply-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .supply-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .supply-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  .supply-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .supply-list li {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding-left: 1rem;
    position: relative;
  }
  .supply-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .pkg-item {
    display: flex;
    justify-content: space-between;
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-small);
    gap: 1rem;
  }
  .pkg-item:last-child {
    border-bottom: none;
  }
  .pkg-type {
    font-weight: 500;
    color: var(--color-text);
  }
  .pkg-sizes {
    color: var(--color-text-secondary);
    text-align: right;
  }

  .app-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }
  .app-list li {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    padding: 0.75rem 1rem;
    background: var(--color-card);
    border-radius: var(--radius-tags);
    border: 1px solid var(--color-border);
  }

  .safety-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-card);
    background: var(--color-accent);
    border-radius: var(--radius-tags);
    margin-bottom: 1rem;
  }
  .safety-link {
    display: inline-block;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-accent);
    margin-left: 1rem;
  }
  .safety-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .supply-grid {
      grid-template-columns: 1fr;
    }
    .detail {
      padding: var(--space-section) 1rem;
    }
  }
</style>
