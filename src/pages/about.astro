---
import '../styles/local-pages.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { ImageMetadata } from 'astro';
const factory = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/factory-nagpur.webp', { eager: true });
const factorySrc = factory['/src/assets/products/factory-nagpur.webp'].default.src;
---

<BaseLayout businessSchema="full" title="About Sunrise Gases — Industrial Gas Supplier, Nagpur" description="Sunrise Gases has supplied industrial and specialty gases in Nagpur since 2013. Sadar office and MIDC Hingna Road godown. Orders 24×7.">
  <article class="page">
    <header class="page-hero">
      <div class="page-hero-bg" aria-hidden="true">
        <img src={factorySrc} alt="Sunrise Gases manufacturing facility in Nagpur, Maharashtra" />
      </div>
      <div class="page-hero-overlay">
        <h1 class="page-title">About Sunrise Gases</h1>
      </div>
    </header>

    <section class="page-section">
      <p class="page-text">Sunrise Gases is an industrial gas manufacturing and supply company based in <strong>Nagpur, Maharashtra</strong>. We manufacture, package, and deliver a comprehensive range of industrial and specialty gases to customers across Central India.</p>
      <p class="page-text">Founded with a focus on reliability and quality, we supply oxygen, nitrogen, argon, carbon dioxide, hydrogen, helium, dissolved acetylene, LPG, and ammonia — along with gas handling equipment, fire safety products, and custom advertising balloons.</p>
    </section>

    <section class="page-section">
      <h2 class="section-title">Manufacturing</h2>
      <p class="page-text">Our facility in Nagpur houses cylinder filling infrastructure and quality control systems to ensure every delivery meets the specified purity and safety standards. We supply both compressed cylinder and bulk/liquid forms.</p>
    </section>

    <section class="page-section">
      <h2 class="section-title">Service area</h2>
      <p class="page-text">We serve industries across Central India, including Maharashtra, Madhya Pradesh, Chhattisgarh, and neighbouring regions. Our logistics network supports timely delivery to industrial customers, hospitals, fabrication shops, and event organisers.</p>
    </section>

    <section class="page-section">
      <h2 class="section-title">Contact</h2>
      <p class="page-text">Nagpur, Maharashtra<br />
      <a href="/contact/" class="page-link">Contact us for inquiries and quotes →</a></p>
    </section>
  </article>
  <section class="lp" style="padding-top:0">
    <h2 class="lp-h2">Where we work</h2>
    <p class="lp-p">Our <a class="lp-link" href="/locations/sadar/">Sadar office</a> is our registered office for enquiries, orders and billing. Our <a class="lp-link" href="/locations/hingna-midc/">MIDC Hingna Road office and godown</a> is where cylinders are stocked and deliveries are dispatched. Orders are taken 24 hours a day; see our <a class="lp-link" href="/service-area/">delivery areas</a>.</p>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .page-hero {
    margin-bottom: 2rem;
    position: relative;
    border-radius: var(--radius-cards);
    overflow: hidden;
    min-height: 240px;
    display: flex;
    align-items: flex-end;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
  }
  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero-overlay {
    position: relative;
    padding: 2rem;
    background: linear-gradient(to top, rgba(29, 30, 28, 0.7), transparent);
    width: 100%;
  }
  .page-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-paper-white);
  }

  .page-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .page-section:last-of-type {
    border-bottom: 1px solid var(--color-border);
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .page-text {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 1rem;
  }
  .page-text:last-child {
    margin-bottom: 0;
  }
  .page-link {
    color: var(--color-accent-text);
    font-weight: 500;
  }
  .page-link:hover {
    text-decoration: underline;
  }
</style>
