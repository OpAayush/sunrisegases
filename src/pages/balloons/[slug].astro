---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('balloons');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Balloons", "item": "https://sunrisegases.com/balloons/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/balloons/${data.slug}/` }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": data.name,
  "description": data.summary,
  "brand": { "@type": "Brand", "name": "Sunrise Gases" },
  "image": data.images?.[0] ? `https://sunrisegases.com${data.images[0].src}` : undefined,
};
---

<BaseLayout title={data.seo.title} description={data.seo.description} schemas={[breadcrumbSchema, productSchema]}>
  <article class="detail">
    <header class="detail-hero">
      <h1 class="detail-name">{data.name}</h1>
      <p class="detail-summary">{data.summary}</p>
    </header>

    {data.images && data.images.length > 0 && (
      <div class="product-images">
        {data.images.map((img) => (
          <img src={img.src} alt={img.alt} class="product-image" width="400" height="400" loading="lazy" />
        ))}
      </div>
    )}

    <section class="detail-section">
      <h2 class="section-title">Sizes</h2>
      <div class="size-list">
        {data.sizes.map((size) => <span class="size-chip">{size}</span>)}
      </div>
    </section>

    {data.customization && data.customization.length > 0 && (
      <section class="detail-section">
        <h2 class="section-title">Customization</h2>
        <ul class="custom-list">
          {data.customization.map((opt) => <li>{opt}</li>)}
        </ul>
      </section>
    )}

    {data.heliumRequirement && (
      <section class="detail-section">
        <h2 class="section-title">Helium requirements</h2>
        <p class="helium-text">{data.heliumRequirement}</p>
      </section>
    )}

    {data.applications && data.applications.length > 0 && (
      <section class="detail-section detail-section--last">
        <h2 class="section-title">Applications</h2>
        <ul class="app-list">
          {data.applications.map((app) => <li>{app}</li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .detail-hero {
    margin-bottom: 2rem;
  }
  .detail-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  .detail-summary {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 640px;
  }

  .detail-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-top: -1px;
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .size-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .size-chip {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: var(--text-small);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tags);
    font-weight: 500;
    color: var(--color-text);
  }

  .custom-list, .app-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .custom-list li, .app-list li {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }
  .custom-list li::before, .app-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .helium-text {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
