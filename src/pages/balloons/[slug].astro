---
import ProductDetailLayout from '../../layouts/ProductDetailLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('balloons');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Balloons", "item": "https://sunrisegases.com/balloons/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/balloons/${data.slug}/` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": data.name,
  "name": `${data.name} Supply — Sunrise Gases`,
  "description": data.summary ?? data.seo.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Sunrise Gases",
    "@id": "https://sunrisegases.com/#business",
  },
  "areaServed": [
    { "@type": "City", "name": "Nagpur" },
    { "@type": "City", "name": "Kamptee" },
    { "@type": "City", "name": "Hingna" },
    { "@type": "City", "name": "Kalmeshwar" },
  ],
  "image": data.images?.[0] ? `https://sunrisegases.com${data.images[0].src.src}` : undefined,
};
---

<ProductDetailLayout
  title={data.seo.title}
  description={data.seo.description}
  schemas={[breadcrumbSchema, serviceSchema]}
  hero={{
    name: data.name,
    summary: data.summary,
    size: 'md',
  }}
  images={data.images}
>
  <section class="detail-section detail-section--bordered detail-section--stacked">
    <h2 class="section-title">Sizes</h2>
    <div class="size-list">
      {data.sizes.map((size) => <span class="size-chip">{size}</span>)}
    </div>
  </section>

  {data.customization && data.customization.length > 0 && (
    <section class="detail-section detail-section--bordered detail-section--stacked">
      <h2 class="section-title">Customization</h2>
      <ul class="custom-list">
        {data.customization.map((opt) => <li>{opt}</li>)}
      </ul>
    </section>
  )}

  {data.heliumRequirement && (
    <section class="detail-section detail-section--bordered detail-section--stacked">
      <h2 class="section-title">Helium requirements</h2>
      <p class="helium-text">{data.heliumRequirement}</p>
    </section>
  )}

  {data.applications && data.applications.length > 0 && (
    <section class="detail-section detail-section--last detail-section--stacked">
      <h2 class="section-title">Applications</h2>
      <ul class="app-list">
        {data.applications.map((app) => <li>{app}</li>)}
      </ul>
    </section>
  )}
</ProductDetailLayout>

<style>
  .size-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .size-chip {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: var(--text-small);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tags);
    font-weight: 500;
    color: var(--color-text);
  }

  .custom-list, .app-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .custom-list li, .app-list li {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }
  .custom-list li::before, .app-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .helium-text {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
