---
import ProductImage from '../../components/ProductImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('fire-safety');
---

<BaseLayout title="Fire Extinguishers & Fire Safety Equipment | Sunrise Gases" description="Fire extinguishers and fire suppression equipment for commercial and industrial use. ABC powder, CO₂, and more. Supplied from Nagpur.">
  <header class="catalog-hero">
    <h1 class="catalog-title">Fire safety</h1>
    <p class="catalog-subtitle">Extinguishers and fire suppression equipment for industrial and commercial applications.</p>
  </header>

  <section class="catalog-grid">
    {items.sort((a, b) => a.data.name.localeCompare(b.data.name)).map((item) => (
      <a href={`/fire-safety/${item.data.slug}/`} class="product-card">
        {item.data.images?.[0] && (
          <ProductImage src={item.data.images[0].src} alt={item.data.images[0].alt} class="product-card-img" widths={[96, 160]} sizes="48px" loading="lazy" />
        )}
        <h2 class="product-name">{item.data.name}</h2>
        <span class="product-detail">{item.data.agentType}</span>
        <span class="product-rating">Class {item.data.fireClassRating.join(', ')}</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .catalog-hero {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
  }
  .catalog-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .catalog-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 540px;
  }

  .catalog-grid {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: 2rem 1.5rem var(--space-section);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .product-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .product-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .product-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-text);
  }
  .product-detail {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  .product-rating {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent-text);
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .catalog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
