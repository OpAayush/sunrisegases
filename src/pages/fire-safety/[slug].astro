---
import ProductDetailLayout from '../../layouts/ProductDetailLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('fire-safety');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Fire Safety", "item": "https://sunrisegases.com/fire-safety/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/fire-safety/${data.slug}/` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": data.name,
  "name": `${data.name} Supply — Sunrise Gases`,
  "description": data.seo.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Sunrise Gases",
    "@id": "https://sunrisegases.com/#business",
  },
  "areaServed": [
    { "@type": "City", "name": "Nagpur" },
    { "@type": "City", "name": "Kamptee" },
    { "@type": "City", "name": "Hingna" },
    { "@type": "City", "name": "Kalmeshwar" },
  ],
  "image": data.images?.[0] ? `https://sunrisegases.com${data.images[0].src.src}` : undefined,
};
---

<ProductDetailLayout
  title={data.seo.title}
  description={data.seo.description}
  schemas={[breadcrumbSchema, serviceSchema]}
  hero={{
    name: data.name,
    label: 'Fire Safety',
    size: 'sm',
  }}
  images={data.images}
>
  <section class="detail-section detail-section--bordered">
    <h2 class="section-title">Specifications</h2>
    <div class="spec-list">
      <div class="spec-row">
        <span class="spec-label">Agent type</span>
        <span class="spec-value">{data.agentType}</span>
      </div>
      <div class="spec-row">
        <span class="spec-label">Fire class rating</span>
        <span class="spec-value">{data.fireClassRating.join(', ')}</span>
      </div>
      {data.sizes && data.sizes.length > 0 && (
        <div class="spec-row">
          <span class="spec-label">Available sizes</span>
          <span class="spec-value">{data.sizes.join(', ')}</span>
        </div>
      )}
      <div class="spec-row">
        <span class="spec-label">Discharge time</span>
        <span class="spec-value">{data.dischargeTime}</span>
      </div>
      <div class="spec-row">
        <span class="spec-label">Refill interval</span>
        <span class="spec-value">{data.refillInterval}</span>
      </div>
    </div>
  </section>
</ProductDetailLayout>

<style>
  .spec-list {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-small);
    gap: 1rem;
  }
  .spec-row:last-child {
    border-bottom: none;
  }
  .spec-label {
    font-weight: 500;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .spec-value {
    color: var(--color-text-secondary);
    text-align: right;
  }
</style>
