---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('equipment');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <article class="detail">
    <header class="detail-hero">
      <span class="detail-category">{data.category}</span>
      <h1 class="detail-name">{data.name}</h1>
    </header>

    <section class="detail-section">
      <h2 class="section-title">Specifications</h2>
      <div class="spec-list">
        {data.specs.map((spec) => (
          <div class="spec-row">
            <span class="spec-label">{spec.label}</span>
            <span class="spec-value">{spec.value}</span>
          </div>
        ))}
      </div>
    </section>

    {data.compatibleWith && data.compatibleWith.length > 0 && (
      <section class="detail-section detail-section--last">
        <h2 class="section-title">Compatible with</h2>
        <div class="compat-list">
          {data.compatibleWith.map((item) => <span class="compat-chip">{item}</span>)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .detail-hero {
    margin-bottom: 2rem;
  }
  .detail-category {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }
  .detail-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
  }

  .detail-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .detail-section--last {
    border-bottom: 1px solid var(--color-border);
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .spec-list {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-small);
    gap: 1rem;
  }
  .spec-row:last-child {
    border-bottom: none;
  }
  .spec-label {
    font-weight: 500;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .spec-value {
    color: var(--color-text-secondary);
    text-align: right;
  }

  .compat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .compat-chip {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    font-size: var(--text-small);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tags);
    color: var(--color-text-secondary);
  }
</style>
