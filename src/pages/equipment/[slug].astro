---
import ProductDetailLayout from '../../layouts/ProductDetailLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('equipment');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Equipment", "item": "https://sunrisegases.com/equipment/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/equipment/${data.slug}/` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": data.name,
  "name": `${data.name} Supply — Sunrise Gases`,
  "description": data.seo.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Sunrise Gases",
    "@id": "https://sunrisegases.com/#business",
  },
  "areaServed": [
    { "@type": "City", "name": "Nagpur" },
    { "@type": "City", "name": "Kamptee" },
    { "@type": "City", "name": "Hingna" },
    { "@type": "City", "name": "Kalmeshwar" },
  ],
  "image": data.images?.[0] ? `https://sunrisegases.com${data.images[0].src.src}` : undefined,
};
---

<ProductDetailLayout
  title={data.seo.title}
  description={data.seo.description}
  schemas={[breadcrumbSchema, serviceSchema]}
  hero={{
    name: data.name,
    category: data.category,
    size: 'sm',
  }}
  images={data.images}
>
  <section class="detail-section">
    <h2 class="section-title">Specifications</h2>
    <div class="spec-list">
      {data.specs.map((spec) => (
        <div class="spec-row">
          <span class="spec-label">{spec.label}</span>
          <span class="spec-value">{spec.value}</span>
        </div>
      ))}
    </div>
  </section>

  {data.compatibleWith && data.compatibleWith.length > 0 && (
    <section class="detail-section detail-section--last">
      <h2 class="section-title">Compatible with</h2>
      <div class="compat-list">
        {data.compatibleWith.map((item) => <span class="compat-chip">{item}</span>)}
      </div>
    </section>
  )}
</ProductDetailLayout>

<style>
  .spec-list {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-small);
    gap: 1rem;
  }
  .spec-row:last-child {
    border-bottom: none;
  }
  .spec-label {
    font-weight: 500;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .spec-value {
    color: var(--color-text-secondary);
    text-align: right;
  }

  .compat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .compat-chip {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    font-size: var(--text-small);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tags);
    color: var(--color-text-secondary);
  }
</style>
