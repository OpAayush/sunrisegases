---
import ProductDetailLayout from '../../layouts/ProductDetailLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('industries');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://sunrisegases.com/industries/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/industries/${data.slug}/` }
  ]
};
---

<ProductDetailLayout
  title={data.seo.title}
  description={data.seo.description}
  schemas={[breadcrumbSchema]}
  hero={{
    name: data.name,
    summary: data.summary,
    size: 'md',
  }}
>
  {data.relevantProducts && data.relevantProducts.length > 0 && (
    <section class="detail-section detail-section--bordered">
      <h2 class="section-title">Relevant products</h2>
      <div class="product-list">
        {data.relevantProducts.map((slug) => {
          const formatted = slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
          return <span class="product-chip">{formatted}</span>;
        })}
      </div>
    </section>
  )}
</ProductDetailLayout>

<style>
  .product-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .product-chip {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: var(--text-small);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tags);
    color: var(--color-text);
    font-weight: 500;
  }
</style>
