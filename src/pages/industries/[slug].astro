---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('industries');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sunrisegases.com/" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://sunrisegases.com/industries/" },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": `https://sunrisegases.com/industries/${data.slug}/` }
  ]
};

---

<BaseLayout title={data.seo.title} description={data.seo.description} schemas={[breadcrumbSchema]}>
  <article class="detail">
    <header class="detail-hero">
      <h1 class="detail-name">{data.name}</h1>
      <p class="detail-summary">{data.summary}</p>
    </header>

    {data.relevantProducts && data.relevantProducts.length > 0 && (
      <section class="detail-section">
        <h2 class="section-title">Relevant products</h2>
        <div class="product-list">
          {data.relevantProducts.map((slug) => {
            const formatted = slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            return <span class="product-chip">{formatted}</span>;
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .detail-hero {
    margin-bottom: 2rem;
  }
  .detail-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  .detail-summary {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 640px;
  }

  .detail-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .product-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .product-chip {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: var(--text-small);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tags);
    color: var(--color-text);
    font-weight: 500;
  }
</style>
