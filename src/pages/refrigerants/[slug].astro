---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('refrigerants');
  return items.map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <article class="detail">
    <header class="detail-hero">
      <span class="detail-label">Refrigerant</span>
      <h1 class="detail-name">{data.name}</h1>
    </header>

    {data.images && data.images.length > 0 && (
      <div class="product-images">
        {data.images.map((img) => (
          <img src={img.src} alt={img.alt} class="product-image" />
        ))}
      </div>
    )}

    <section class="detail-section">
      <h2 class="section-title">Specifications</h2>
      <div class="spec-list">
        <div class="spec-row">
          <span class="spec-label">Grade</span>
          <span class="spec-value">{data.grade}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">ODP</span>
          <span class="spec-value">{data.odp}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">GWP</span>
          <span class="spec-value">{data.gwp}</span>
        </div>
      </div>
    </section>

    {data.retrofitCompatibility && data.retrofitCompatibility.length > 0 && (
      <section class="detail-section">
        <h2 class="section-title">Retrofit compatibility</h2>
        <div class="compat-list">
          {data.retrofitCompatibility.map((ref) => <span class="compat-chip">{ref}</span>)}
        </div>
      </section>
    )}

    <section class="detail-section detail-section--last">
      <h2 class="section-title">Packaging</h2>
      {data.packaging.map((pkg) => (
        <div class="pkg-item">
          <span class="pkg-type">{pkg.type}</span>
          <span class="pkg-sizes">{pkg.sizes.join(', ')}</span>
        </div>
      ))}
      {data.safety?.hazardClass && <div class="safety-badge">{data.safety.hazardClass}</div>}
    </section>
  </article>
</BaseLayout>

<style>
  .detail { max-width: var(--space-container); margin: 0 auto; padding: var(--space-section) 1.5rem; }
  .detail-hero { margin-bottom: 2rem; }
  .detail-label { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent); display: block; margin-bottom: 0.5rem; }
  .detail-name { font-family: var(--font-serif); font-weight: 600; font-size: var(--text-hero); line-height: 1.2; color: var(--color-text); }
  .detail-section { padding: 2rem 0; border-top: 1px solid var(--color-border); }
  .detail-section--last { border-bottom: 1px solid var(--color-border); }
  .section-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h2); color: var(--color-text); margin-bottom: 1.25rem; }
  .spec-list { background: var(--color-card); border-radius: var(--radius-cards); overflow: hidden; box-shadow: var(--shadow-sm); }
  .spec-row { display: flex; justify-content: space-between; padding: 0.875rem 1.5rem; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); gap: 1rem; }
  .spec-row:last-child { border-bottom: none; }
  .spec-label { font-weight: 500; color: var(--color-text); flex-shrink: 0; }
  .spec-value { color: var(--color-text-secondary); text-align: right; }
  .compat-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .compat-chip { display: inline-block; padding: 0.375rem 0.75rem; font-size: var(--text-small); background: var(--color-card); border: 1px solid var(--color-border); border-radius: var(--radius-tags); color: var(--color-text-secondary); }
  .pkg-item { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--color-border); font-size: var(--text-small); }
  .pkg-item:last-of-type { border-bottom: none; }
  .pkg-type { font-weight: 500; color: var(--color-text); }
  .pkg-sizes { color: var(--color-text-secondary); }
  .safety-badge { display: inline-block; margin-top: 1rem; padding: 0.25rem 0.75rem; font-size: var(--text-small); font-weight: 600; color: var(--color-card); background: var(--color-accent); border-radius: var(--radius-tags); }
</style>
