---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Get a Quote for Industrial Gases | Sunrise Gases" description="Get in touch with Sunrise Gases for industrial gas supply, equipment, fire safety, and balloon inquiries. Based in Nagpur, serving Central India.">
  <article class="page">
    <header class="page-hero">
      <h1 class="page-title">Contact</h1>
      <p class="page-subtitle">Get a quote or ask about our products and services.</p>
    </header>

    <div class="contact-grid">
      <section class="contact-card">
        <h2 class="card-title">Visit or call</h2>
        <address class="contact-address">
          <strong>Sunrise Gases</strong><br />
          Nagpur, Maharashtra<br />
          India
        </address>
        <p class="contact-note">Contact us for pricing, availability, and technical specifications.</p>
        <a href="/gases/" class="contact-link">Browse our products &rarr;</a>
      </section>

      <section class="contact-card">
        <h2 class="card-title">Quick inquiry</h2>
        <p class="contact-note">Tell us what you need — gas type, quantity, delivery location, and we'll get back to you with a quote.</p>
        <p class="contact-form-placeholder">Quote form coming soon. For now, please call or email us.</p>
        <a href="mailto:info@sunrisegases.com" class="contact-link">info@sunrisegases.com &rarr;</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .page-hero {
    margin-bottom: 2rem;
  }
  .page-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 480px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .contact-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
  }
  .contact-address {
    font-style: normal;
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .contact-note {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .contact-form-placeholder {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding: 0.75rem;
    background: var(--color-bg);
    border-radius: var(--radius-buttons);
    border: 1px dashed var(--color-border);
    text-align: center;
  }
  .contact-link {
    display: inline-block;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-accent);
    margin-top: auto;
  }
  .contact-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
