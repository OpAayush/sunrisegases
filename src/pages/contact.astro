---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { ImageMetadata } from 'astro';
const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/icon-*.svg', { eager: true });
const iconSrc = (name: string) => icons[`/src/assets/products/${name}.svg`].default.src;
---

<BaseLayout title="Contact — Get a Quote for Industrial Gases | Sunrise Gases" description="Get in touch with Sunrise Gases for industrial gas supply, equipment, fire safety, and balloon inquiries. Based in Nagpur, serving Central India.">
  <article class="page">
    <header class="page-hero">
      <h1 class="page-title">Contact</h1>
      <p class="page-subtitle">Get a quote or ask about our products and services.</p>
    </header>

    <div class="locations-grid">
      <section class="location-card">
        <div class="card-header">
          <img src={iconSrc('icon-map-pin')} alt="" class="icon-inline card-icon" />
          <h2 class="card-title">Registered Office</h2>
        </div>
        <p class="card-label">Sadar, Nagpur</p>
        <address class="location-address">
          <strong>Sunrise Gases</strong><br />
          Meghraj Chawl, 212A, Gandhi Chowk<br />
          Sadar, Nagpur<br />
          Maharashtra 440001
        </address>
        <a href="https://maps.app.goo.gl/pmto13xLtkvdeTrn9" target="_blank" rel="noopener noreferrer" class="map-link">Open in Google Maps &rarr;</a>
        <div class="map-wrap">
          <iframe src="https://www.google.com/maps?q=Gandhi+Chowk+Sadar+Nagpur+Maharashtra+440001&z=15&output=embed" width="100%" height="220" style="border:0; border-radius: 12px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </section>

      <section class="location-card">
        <div class="card-header">
          <img src={iconSrc('icon-map-pin')} alt="" class="icon-inline card-icon" />
          <h2 class="card-title">Works</h2>
        </div>
        <p class="card-label">MIDC, Hingna Road</p>
        <address class="location-address">
          <strong>Sunrise Gases</strong><br />
          Sharma Engineering Works<br />
          W52, near Digdoh Gram Panchayat<br />
          MIDC, Hingna Road<br />
          Nagpur 440016
        </address>
        <a href="https://www.google.com/maps?q=21.1154769,79.0007651&z=17&hl=en" target="_blank" rel="noopener noreferrer" class="map-link">Open in Google Maps &rarr;</a>
        <div class="map-wrap">
          <iframe src="https://www.google.com/maps?q=21.1154769,79.0007651&z=15&output=embed" width="100%" height="220" style="border:0; border-radius: 12px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </section>
    </div>

    <div class="contact-grid">
      <section class="contact-card">
        <h2 class="card-title">Get in touch</h2>
        <p class="contact-note">Call or email us for pricing, availability, and technical specifications.</p>
        <div class="contact-links">
          <a href="tel:+919422416090" class="contact-link"><img src={iconSrc('icon-phone')} alt="" class="icon-inline" /> +91-9422416090</a>
          <a href="mailto:contact@sunrisegases.com" class="contact-link"><img src={iconSrc('icon-email')} alt="" class="icon-inline" /> contact@sunrisegases.com</a>
        </div>
        <p class="contact-hours"><img src={iconSrc('icon-clock')} alt="" class="icon-inline" /> Open 24 Hours &middot; 7 Days a Week</p>
      </section>

      <section class="contact-card">
        <h2 class="card-title">Quick inquiry</h2>
        <p class="contact-note">Tell us what you need &mdash; gas type, quantity, delivery location &mdash; and we'll get back with a quote.</p>
        <p class="contact-form-placeholder">Online quote form coming soon. For now, please call or email.</p>
        <a href="mailto:contact@sunrisegases.com" class="contact-link">contact@sunrisegases.com &rarr;</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }
  .page-hero {
    margin-bottom: 2rem;
  }
  .page-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 480px;
  }

  .locations-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .location-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .card-icon {
    color: var(--color-accent);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
  }
  .card-label {
    font-size: var(--text-small);
    color: var(--color-accent-text);
    font-weight: 500;
  }
  .location-address {
    font-style: normal;
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .map-link {
    display: inline-block;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-accent-text);
  }
  .map-link:hover {
    text-decoration: underline;
  }
  .map-wrap {
    margin-top: 0.25rem;
    line-height: 0;
  }
  .map-wrap iframe {
    width: 100%;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .contact-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
  }
  .contact-note {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-accent-text);
  }
  .contact-link:hover {
    text-decoration: underline;
  }
  .contact-hours {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }
  .contact-form-placeholder {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding: 0.75rem;
    background: var(--color-bg);
    border-radius: var(--radius-buttons);
    border: 1px dashed var(--color-border);
    text-align: center;
  }

  @media (max-width: 700px) {
    .locations-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-card {
      padding: 1.5rem;
    }
  }
  @media (max-width: 400px) {
    .page {
      padding: 1.5rem 1rem;
    }
    .page-title {
      font-size: 1.75rem;
    }
    .location-card {
      padding: 1.25rem;
    }
    .contact-link {
      font-size: 0.9375rem;
      gap: 0.5rem;
    }
  }
</style>
