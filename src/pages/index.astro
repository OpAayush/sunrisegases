---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const gases = await getCollection('gases');
const equipment = await getCollection('equipment');
const fireSafety = await getCollection('fire-safety');
const balloons = await getCollection('balloons');

const secondaryCategories = [
  { collection: equipment, label: 'Equipment', href: '/equipment/', description: 'Cylinders, valves, manifolds, and gas handling accessories', icon: '/images/icons/truck.svg' },
  { collection: fireSafety, label: 'Fire Safety', href: '/fire-safety/', description: 'Extinguishers and fire suppression', icon: '/images/icons/extinguisher.svg' },
  { collection: balloons, label: 'Balloons', href: '/balloons/', description: 'Custom advertising balloons for events', icon: '/images/icons/package.svg' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I book a gas cylinder in Nagpur?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call +91-9422416090 or message us on WhatsApp. Cylinder supply and refill are available 24 hours, 7 days a week, with delivery across Nagpur and nearby areas."
      }
    },
    {
      "@type": "Question",
      "name": "Are you a gas agency in Nagpur?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sunrise Gases is a gas manufacturer and supplier in Nagpur — industrial and specialty gases, refrigerants, dry ice, fire safety equipment, and gas equipment, serving Central India since 2013."
      }
    },
    {
      "@type": "Question",
      "name": "Do you deliver gas cylinders near me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We deliver across Nagpur (Sadar, Gandhi Chowk, MIDC Hingna Road) and surrounding areas including Kamptee, Hingna, and Kalmeshwar."
      }
    },
    {
      "@type": "Question",
      "name": "नागपुर में गैस एजेंसी कहाँ है?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "हमारा कार्यालय मेघराज चावल, 212A, गांधी चौक, सदर, नागपुर 440001 में है और फैक्ट्री MIDC, हिंगणा रोड पर है। फोन: +91-9422416090।"
      }
    },
    {
      "@type": "Question",
      "name": "क्या आप 24 घंटे गैस सिलेंडर की डिलीवरी करते हैं?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "हाँ, हम सप्ताह के सातों दिन 24 घंटे नागपुर, कामठी, हिंगणा और कलमेश्वर में गैस सिलेंडर की डिलीवरी करते हैं।"
      }
    },
    {
      "@type": "Question",
      "name": "ऑक्सीजन सिलेंडर कहाँ से मिलता है?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ऑक्सीजन, नाइट्रोजन, आर्गन, कार्बन डाइऑक्साइड, हीलियम, हाइड्रोजन, LPG और अमोनिया सिलेंडर नागपुर से सप्लाई होते हैं। 10L, 20L और 47L सिलेंडर उपलब्ध हैं।"
      }
    },
    {
      "@type": "Question",
      "name": "ड्राई आइस कहाँ मिलती है?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "फूड ग्रेड ड्राई आइस ब्लॉक और पाउडर फॉर्म में नागपुर में उपलब्ध है — इवेंट, कोल्ड चेन और फूड ट्रांसपोर्ट के लिए।"
      }
    }
  ]
};
---

<BaseLayout title="Industrial & Specialty Gases — Sunrise Gases, Nagpur" description="Industrial and specialty gases manufacturer based in Nagpur. Supplying oxygen, nitrogen, argon, CO₂, hydrogen, helium, and gas equipment across Central India." schemas={[faqSchema]}>
  <section class="hero">
    <div class="hero-bg-decor" aria-hidden="true">
      <img src="/images/icons/flame.svg" alt="" />
    </div>
    <div class="hero-content">
      <h1 class="hero-title">Industrial &amp; specialty<br />gases <span class="hero-accent">manufactured in Nagpur</span></h1>
      <p class="hero-subtitle">Oxygen &middot; Nitrogen &middot; Argon &middot; Carbon Dioxide &middot; Hydrogen &middot; Helium &middot; Dissolved Acetylene &middot; LPG &middot; Ammonia</p>
      <p class="hero-subtitle">Gas agency in Nagpur — cylinder supply, refill &amp; 24-hour delivery.</p>
    </div>
  </section>

  <section class="gas-grid-section">
    <div class="gas-grid">
      {gases.sort((a, b) => a.data.name.localeCompare(b.data.name)).map((gas) => {
        const purity = gas.data.grades?.[0]?.purity;
        return (
          <a href={`/gases/${gas.data.slug}/`} class="gas-card">
            {gas.data.images?.[0] && (
              <img src={gas.data.images[0].src} alt={gas.data.images[0].alt} class="gas-card-img" loading="lazy" />
            )}
            <span class="gas-formula">{gas.data.formula || gas.data.slug.toUpperCase()}</span>
            <span class="gas-name">{gas.data.name}</span>
            {purity && <span class="gas-purity">{purity}</span>}
          </a>
        );
      })}
    </div>
    <a href="/gases/" class="gas-all-link">View all gases and products &rarr;</a>
  </section>

  <section class="also-section">
    <div class="also-row">
      <span class="also-label">Also</span>
      <a href="/gas-mixtures/" class="also-link">
        <img src="/images/icons/flame.svg" alt="" class="also-icon" /> Mixture gases
      </a>
      <a href="/specialty-gases/" class="also-link">
        <img src="/images/icons/shield.svg" alt="" class="also-icon" /> Specialty &amp; calibration
      </a>
      <a href="/refrigerants/" class="also-link">
        <img src="/images/icons/snowflake.svg" alt="" class="also-icon" /> Refrigerants
      </a>
      <a href="/cryogenic/" class="also-link">
        <img src="/images/icons/snowflake.svg" alt="" class="also-icon" /> Cryogenic
      </a>
      (LN₂, dry ice)
    </div>
  </section>

  <section class="categories-section">
    <div class="categories-grid">
      {secondaryCategories.map((cat) => (
        <a href={cat.href} class="category-card">
          <div class="category-card-icon">
            <img src={cat.icon} alt="" />
          </div>
          <h2 class="category-title">{cat.label}</h2>
          <p class="category-description">{cat.description}</p>
          <span class="category-count">{cat.collection.length} product{cat.collection.length !== 1 ? 's' : ''}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="faq-section">
    <h2 class="faq-section-title">Frequently Asked Questions</h2>
    <div class="faq-list">
      <div class="faq-item">
        <h3 class="faq-question">How do I book a gas cylinder in Nagpur?</h3>
        <p class="faq-answer">Call +91-9422416090 or message us on WhatsApp. Cylinder supply and refill are available 24 hours, 7 days a week, with delivery across Nagpur and nearby areas.</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-question">Are you a gas agency in Nagpur?</h3>
        <p class="faq-answer">Sunrise Gases is a gas manufacturer and supplier in Nagpur — industrial and specialty gases, refrigerants, dry ice, fire safety equipment, and gas equipment, serving Central India since 2013.</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-question">Do you deliver gas cylinders near me?</h3>
        <p class="faq-answer">Yes. We deliver across Nagpur (Sadar, Gandhi Chowk, MIDC Hingna Road) and surrounding areas including Kamptee, Hingna, and Kalmeshwar.</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-question">नागपुर में गैस एजेंसी कहाँ है?</h3>
        <p class="faq-answer">हमारा कार्यालय मेघराज चावल, 212A, गांधी चौक, सदर, नागपुर 440001 में है और फैक्ट्री MIDC, हिंगणा रोड पर है। फोन: +91-9422416090।</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-question">क्या आप 24 घंटे गैस सिलेंडर की डिलीवरी करते हैं?</h3>
        <p class="faq-answer">हाँ, हम सप्ताह के सातों दिन 24 घंटे नागपुर, कामठी, हिंगणा और कलमेश्वर में गैस सिलेंडर की डिलीवरी करते हैं।</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-question">ऑक्सीजन सिलेंडर कहाँ से मिलता है?</h3>
        <p class="faq-answer">ऑक्सीजन, नाइट्रोजन, आर्गन, कार्बन डाइऑक्साइड, हीलियम, हाइड्रोजन, LPG और अमोनिया सिलेंडर नागपुर से सप्लाई होते हैं। 10L, 20L और 47L सिलेंडर उपलब्ध हैं।</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-question">ड्राई आइस कहाँ मिलती है?</h3>
        <p class="faq-answer">फूड ग्रेड ड्राई आइस ब्लॉक और पाउडर फॉर्म में नागपुर में उपलब्ध है — इवेंट, कोल्ड चेन और फूड ट्रांसपोर्ट के लिए।</p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <p class="cta-text">Need a gas cylinder refill or booking in Nagpur? We're open 24 hours, 7 days a week.</p>
    <a href="/contact/" class="cta-button">Get a quote &rarr;</a>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-decor {
    position: absolute;
    right: -3rem;
    top: -4rem;
    width: 280px;
    height: 280px;
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
  }
  .hero-bg-decor img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-content {
    max-width: 800px;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  .hero-accent {
    color: var(--color-accent);
  }
  .hero-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 600px;
  }

  .gas-grid-section {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
  }
  .gas-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .gas-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
    position: relative;
  }
  .gas-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
    z-index: 1;
  }
  .gas-card-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    margin-bottom: 0.375rem;
    border-radius: 8px;
  }
  .gas-formula {
    font-family: var(--font-mono);
    font-size: var(--text-formula);
    font-weight: 400;
    color: var(--color-accent);
    line-height: 1.2;
  }
  .gas-name {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text);
  }
  .gas-purity {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-top: 0.125rem;
  }
  .gas-all-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-accent);
  }
  .gas-all-link:hover {
    text-decoration: underline;
  }

  .also-section {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
  }
  .also-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.25rem;
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .also-label {
    font-weight: 600;
    color: var(--color-accent);
    margin-right: 0.25rem;
  }
  .also-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .also-link:hover {
    text-decoration-thickness: 2px;
  }
  .also-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .categories-section {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
  }
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .category-card {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .category-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .category-card-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-marigold-glow);
    border-radius: 12px;
    margin-bottom: 0.25rem;
  }
  .category-card-icon img {
    width: 22px;
    height: 22px;
  }
  .category-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--color-text);
    line-height: var(--leading-tight);
  }
  .category-description {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
  .category-count {
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-top: auto;
  }

  .cta-section {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
    text-align: center;
  }
  .faq-section {
    max-width: var(--space-container);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem 0;
  }
  .faq-section-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    background: var(--color-card);
    border-radius: var(--radius-cards);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .faq-question {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .faq-answer {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .cta-text {
    font-size: var(--text-h3);
    font-weight: 500;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .cta-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    font-size: var(--text-body);
    font-weight: 600;
    background: var(--color-cta);
    color: #fff;
    border-radius: var(--radius-buttons);
    box-shadow: var(--shadow-sm);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }
  .cta-button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .gas-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .gas-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .gas-card {
      padding: 1rem;
    }
    .category-card {
      padding: 1.5rem;
    }
    .cta-button {
      display: block;
      text-align: center;
      width: 100%;
    }
  }
  @media (max-width: 400px) {
    .hero {
      padding: 2rem 1rem 0;
    }
    .hero-bg-decor {
      display: none;
    }
    .hero-title {
      font-size: 1.75rem;
    }
    .hero-subtitle {
      font-size: 0.875rem;
    }
    .also-row {
      font-size: 0.875rem;
    }
    .gas-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .gas-card {
      padding: 0.75rem;
    }
    .gas-formula {
      font-size: 1rem;
    }
  }
</style>
